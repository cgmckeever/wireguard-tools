# tunnel-pi settings for one Pi. Copy this file to configs/<name>.conf (git ignores
# that name) and fill it in. The name is the Pi's: up to 10 of a-z, 0-9 and -,
# starting with a letter, e.g. configs/home.conf. Shell syntax: NAME="value".
# scripts/tpi-ctl.sh reads it on your computer: tpi-ctl.sh <name> <command> (the
# name can be left out while there's only one). No secrets go in here: the
# Cloudflare token stays in its own file.

# --- The Pi ------------------------------------------------------------------
# tpi-ctl.sh reaches the Pi the first way that answers, and says which it used:
#   1. SSH_LAN, on your home network while you build it
#   2. through the VPS over the WireGuard link, the everyday way after drop-off
#   3. SSH_CLOUDFLARE, the emergency door (below), when the link is down
SSH_LAN="pi@tunnel-pi.local"        # user@name of the Pi on your home network, as set in Raspberry Pi Imager

# Optional: the emergency door. SSH through a Cloudflare Tunnel, which doesn't
# depend on the WireGuard link, so you can still get in and fix the Pi when the
# link is down (a blocked port, a changed VPS IP, a bad change). Costs a domain
# on Cloudflare and step 1.3. Empty: no Cloudflare; if the link is down after
# drop-off, the friend power-cycles the Pi, or you take it home.
SSH_CLOUDFLARE=""                   # e.g. ssh.pi.example.com, a hostname on your Cloudflare domain
CF_TOKEN_FILE="$HOME/.config/tunnel-pi/cloudflared.token"   # with SSH_CLOUDFLARE: the tunnel token alone, mode 600

# --- The VPS -----------------------------------------------------------------
# A VPS you manage with wgt-ctl: name it here (as `bin/wgt-ctl list` shows it),
# and tpi-ctl.sh drives it through wgt-ctl. VPS_SSH and VPS_HOST then come from that
# list (VPS_HOST only if you leave it as the example). Empty: tpi-ctl.sh uses ssh itself.
WGT_SERVER=""
VPS_SSH="root@vps.example.com"      # how ssh reaches the VPS: root, or a user with passwordless sudo
VPS_HOST="vps.example.com"          # the VPS's public name or IP, as the Pi dials it
PI_PORT=""                          # the link's UDP port on the VPS. Empty: link picks a free one (from 51821) and saves it here. 443, if free, is rarely filtered
# The link's subnet on the VPS, a /30 in 10.99.0.0/24. Leave it empty: link picks
# one nothing on the VPS uses and saves it here. Never change it once set.
TPI_LINK=""

# --- Routing: what sends clients into the Pi ---------------------------------
TPI_ROUTING="tpi"                   # tpi: tunnel-pi does the routing, on any WireGuard VPS. wgt: a wgt jump

# TPI_ROUTING="tpi" only
CLIENT_IPS=""                       # the clients that exit via the Pi: space-separated IPv4 addresses, as in each client's config
CLIENT_IP6S=""                      # their IPv6 addresses, if any (blocked: the link is IPv4 only)
WG_IF="wg0"                         # the WireGuard interface those clients connect to on the VPS
WG_SUBNET=""                        # leave empty (it means every subnet WG_IF is on)

# TPI_ROUTING="wgt" only (the VPS runs wgt, the wireguard-tools in this repository)
JUMP_CODE="home"                    # 2-6 of a-z 0-9 -, not already in `wgt jump list`
JUMP_LABEL="Friend's house"
JUMP_LAN_CODE=""                    # optional second jump in LAN mode (2.3), e.g. homelan
JUMP_LAN_LABEL=""                   # e.g. "Friend's house (LAN)"
