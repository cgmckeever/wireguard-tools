#!/bin/sh
# tp: set up tunnel-pi from your computer (macOS or Linux). Reads ../tunnel-pi.conf (or $TP_CONF)
# and runs pi.sh on the Pi and vps.sh on the VPS over ssh.
#
#   tp config              show the settings and check they're filled in
#   tp ssh-config          print the ~/.ssh/config entry for ADMIN_HOST
#   tp base                phase 1 on the Pi: packages, updates, watchdog, cloudflared
#   tp link                phase 2A: the wgpi link (Pi and VPS), keys exchanged for you
#   tp exit                phase 2B or 2C, by EXIT: the hand routing's DNS, or the wgt jump(s)
#   tp client <device> [lan]   2C: a config for <device> through the Pi (lan: the LAN jump)
#   tp lan-mode isolated|lan [<interface>]   2D: switch LAN mode (default: wgpi or wgjump)
#   tp check               PASS/FAIL on the Pi and the VPS
#   tp all                 link, exit, check (after base)
#   tp undo [all]          remove it from the VPS and the Pi (all: cloudflared too)
#
# Anything that changes the VPS asks first. TP_YES=1 skips that question (only
# once the person has agreed to these changes on this VPS). TP_DRY_RUN=1 shows
# what would run and changes nothing.
set -eu

HERE=$(cd "$(dirname "$0")" && pwd)
CONF="${TP_CONF:-$HERE/../tunnel-pi.conf}"

log() { printf '==> %s\n' "$*" >&2; }
die() { printf 'tp: %s\n' "$*" >&2; exit 1; }

case "${1:-}" in ''|-h|--help|help) sed -n '2,19s/^# \{0,1\}//p' "$0"; exit 0 ;; esac
[ -r "$CONF" ] || die "no settings at $CONF: cp tunnel-pi.conf.example tunnel-pi.conf, fill it in"
# shellcheck disable=SC1090
. "$CONF"
: "${PI_SSH:=}" "${VPS_SSH:=}" "${ADMIN_HOST:=}" "${PI_USER:=pi}" "${CF_TOKEN_FILE:=}"
: "${VPS_HOST:=}" "${PI_PORT:=}" "${EXIT:=jump}" "${JUMP_CODE:=}" "${JUMP_LABEL:=}"
: "${WG_IF:=wg0}" "${JUMP_LAN_CODE:=}" "${JUMP_LAN_LABEL:=}" "${CLIENT_IPS:=}" "${CLIENT_IP6S:=}" "${WG_SUBNET:=}"
PI_PUBKEY="" VPS_PUBKEY="" CF_TOKEN=""
DRY="${TP_DRY_RUN:-}"

# q <value>: the value quoted for sh.
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# The settings pi.sh and vps.sh read, as sh assignments (sent ahead of the script).
vars() {
    for v in VPS_HOST PI_PORT EXIT WG_IF JUMP_CODE JUMP_LAN_CODE CLIENT_IPS CLIENT_IP6S WG_SUBNET \
             PI_PUBKEY VPS_PUBKEY CF_TOKEN; do
        eval "val=\${$v}"
        printf '%s=%s\n' "$v" "$(q "$val")"
    done
    [ -z "${TP_RENEW:-}" ] || echo "TP_RENEW=$(q "$TP_RENEW")"
}

# run <ssh-target> <script> <args...>: stream the settings and the script; run it as root.
run() {
    host="$1" script="$2"; shift 2
    if [ -n "$DRY" ]; then log "[dry-run] on $host: $script $*"; return 0; fi
    { vars; cat "$HERE/$script"; } | ssh "$host" \
        "if [ \"\$(id -u)\" = 0 ]; then sh -s -- $*; else sudo sh -s -- $*; fi"
}

# The remote prefix that runs a command as root (sudo unless already root).
AS_ROOT='if [ "$(id -u)" = 0 ]; then S=; else S=sudo; fi; $S'

# sshx <ssh-target> <command>: a remote command, as root (shown, not run, in a dry run).
sshx() {
    if [ -n "$DRY" ]; then log "[dry-run] on $1: $2"; return 0; fi
    ssh "$1" "$AS_ROOT $2"
}

placeholder() { case "$1" in ''|*example.com*|*'<'*) return 0 ;; esac; return 1; }

require() {
    for v in "$@"; do
        eval "val=\${$v}"
        ! placeholder "$val" || die "$v in $CONF is empty or still the example"
    done
}

confirm_vps() {
    [ -z "$DRY" ] || return 0
    [ "${TP_YES:-}" = 1 ] && return 0
    [ -n "${CONFIRMED:-}" ] && return 0
    printf 'This changes the VPS %s (%s). Continue? [y/N] ' "$VPS_SSH" "$1" >&2
    read -r answer < /dev/tty || answer=""
    case "$answer" in y|Y|yes) CONFIRMED=1 ;; *) die "stopped; nothing more was changed on the VPS" ;; esac
}

pubkey_from() { sed -n 's/^PUBKEY=//p' | tail -n 1; }

cmd_config() {
    printf '%s\n' "settings: $CONF"
    for v in PI_SSH VPS_SSH ADMIN_HOST PI_USER CF_TOKEN_FILE VPS_HOST PI_PORT EXIT WG_IF \
             JUMP_CODE JUMP_LABEL JUMP_LAN_CODE JUMP_LAN_LABEL CLIENT_IPS CLIENT_IP6S WG_SUBNET; do
        eval "val=\${$v}"
        printf '  %-15s %s\n' "$v" "${val:-(empty)}"
    done
    require PI_SSH VPS_SSH VPS_HOST PI_PORT
    case "$EXIT" in
        jump) require JUMP_CODE JUMP_LABEL
              case "$JUMP_CODE" in *[!a-z0-9-]*) die "JUMP_CODE: only a-z, 0-9 and -" ;; esac ;;
        hand) require CLIENT_IPS ;;
        *) die "EXIT must be jump or hand" ;;
    esac
    [ -z "$CF_TOKEN_FILE" ] || [ -r "$CF_TOKEN_FILE" ] || log "note: CF_TOKEN_FILE $CF_TOKEN_FILE isn't readable yet (tp base needs it)"
    log "settings look complete"
}

cmd_ssh_config() {
    require ADMIN_HOST
    bin=$(command -v cloudflared || echo cloudflared)
    cat <<EOF
# Add to ~/.ssh/config. cloudflared must be installed on this computer first
# (macOS: brew install cloudflared; Linux: Cloudflare's package for your system).

Host $ADMIN_HOST
    User $PI_USER
    ProxyCommand $bin access ssh --hostname %h
EOF
}

cmd_base() {
    require PI_SSH
    if [ -n "$CF_TOKEN_FILE" ] && [ -r "$CF_TOKEN_FILE" ]; then
        CF_TOKEN=$(tr -d ' \n\r' < "$CF_TOKEN_FILE")
    else
        log "no readable CF_TOKEN_FILE: cloudflared is installed but not connected (run tp base again once it exists)"
    fi
    run "$PI_SSH" pi.sh base
    CF_TOKEN=""
}

# Install the exit rules script on the Pi (2B and 2C both use it).
install_exit_script() {
    if [ -n "$DRY" ]; then log "[dry-run] on $PI_SSH: install tunnel-pi-exit"; return 0; fi
    ssh "$PI_SSH" "$AS_ROOT install -m 755 /dev/stdin /usr/local/sbin/tunnel-pi-exit" < "$HERE/tunnel-pi-exit"
}

cmd_link() {
    cmd_config >/dev/null
    install_exit_script
    log "Pi: WireGuard and its key"
    PI_PUBKEY=$(run "$PI_SSH" pi.sh link | pubkey_from)
    [ -n "$PI_PUBKEY" ] || [ -n "$DRY" ] || die "the Pi didn't report its public key"
    confirm_vps "a wgpi link$( [ "$EXIT" = hand ] && echo ", routing and a kill switch for $CLIENT_IPS")"
    log "VPS: the wgpi link"
    VPS_PUBKEY=$(run "$VPS_SSH" vps.sh link | pubkey_from)
    [ -n "$VPS_PUBKEY" ] || [ -n "$DRY" ] || die "the VPS didn't report its public key"
    [ -n "$VPS_PUBKEY" ] || VPS_PUBKEY=dry-run
    log "Pi: the wgpi link"
    run "$PI_SSH" pi.sh link >/dev/null
    log "waiting for the first handshake"
    [ -n "$DRY" ] || sleep 8
    run "$PI_SSH" pi.sh check || log "the link isn't fully up yet: run tp check in a minute"
}

# add_jump <isolated|lan> <code> <label>
add_jump() {
    out=$(run "$PI_SSH" pi.sh jump "$1")
    file=$(printf '%s\n' "$out" | sed -n 's/^JUMPFILE=//p')
    if [ -n "$file" ]; then
        confirm_vps "wgt jump add $2"
        log "VPS: wgt jump add $2 (the jump file goes Pi -> VPS through a pipe, never shown)"
        if [ -n "$DRY" ]; then log "[dry-run] would pipe $file into wgt jump add $2"; return 0; fi
        if ssh "$PI_SSH" "$AS_ROOT cat $file" | ssh "$VPS_SSH" "$AS_ROOT wgt jump add $2 - --label $(q "$3") --yes"; then
            run "$PI_SSH" pi.sh jump-done "$1"
        else
            die "wgt jump add $2 failed; the jump file stays on the Pi ($file) so tp exit can try again with TP_RENEW=1"
        fi
    elif [ -z "$DRY" ]; then
        sshx "$VPS_SSH" "wgt jump list" | grep -qw -- "$2" \
            || die "the Pi's jump server exists but the VPS has no jump '$2': run TP_RENEW=1 tp exit"
        log "jump '$2' is already on the VPS"
    fi
}

cmd_exit() {
    cmd_config >/dev/null
    if [ "$EXIT" = hand ]; then
        log "Pi: DNS for Pi-exit clients"
        run "$PI_SSH" pi.sh hand
    else
        install_exit_script
        add_jump isolated "$JUMP_CODE" "$JUMP_LABEL"
        if [ -n "$JUMP_LAN_CODE" ]; then
            require JUMP_LAN_LABEL
            add_jump lan "$JUMP_LAN_CODE" "$JUMP_LAN_LABEL"
        fi
        log "next: tp client <device> to give a device a config through the Pi"
    fi
}

cmd_client() {
    [ "$EXIT" = jump ] || die "tp client is for EXIT=jump; with EXIT=hand, list the config's address in CLIENT_IPS and run tp link"
    device="${1:-}"; [ -n "$device" ] || die "tp client <device> [lan]"
    code="$JUMP_CODE"
    if [ "${2:-}" = lan ]; then code="$JUMP_LAN_CODE"; [ -n "$code" ] || die "JUMP_LAN_CODE isn't set"; fi
    confirm_vps "wgt client add $device --exit $code"
    sshx "$VPS_SSH" "wgt client add $(q "$device") --exit $code --warp off --no-qr --yes"
    log "made $code.$device. On the VPS: wgt client show $code.$device --qr (or wgt client share $code.$device)"
}

cmd_lan_mode() {
    mode="${1:-}"
    case "$mode" in isolated|lan) ;; *) die "tp lan-mode isolated|lan [<interface>]" ;; esac
    ifc="${2:-}"
    [ -n "$ifc" ] || { if [ "$EXIT" = hand ]; then ifc=wgpi; else ifc=wgjump; fi; }
    run "$PI_SSH" pi.sh lan-mode "$ifc" "$mode"
}

cmd_check() {
    rc=0
    log "Pi ($PI_SSH)"
    run "$PI_SSH" pi.sh check || rc=1
    log "VPS ($VPS_SSH)"
    run "$VPS_SSH" vps.sh check || rc=1
    if [ -n "$DRY" ]; then log "(dry run: nothing was checked)"
    elif [ "$rc" = 0 ]; then log "all checks passed"
    else log "some checks failed: see the README's Troubleshooting"; fi
    return "$rc"
}

cmd_undo() {
    confirm_vps "remove wgpi$( [ "$EXIT" = hand ] && echo " and the kill switch")"
    if [ "$EXIT" = jump ]; then
        log "VPS: removing the wgt jump(s). wgt refuses while configs use them: remove those first (wgt client remove <code>.<device>)"
        for code in $JUMP_CODE $JUMP_LAN_CODE; do
            sshx "$VPS_SSH" "wgt jump list" | grep -qw -- "$code" || continue   # already gone
            sshx "$VPS_SSH" "wgt jump remove $code --yes" || die "wgt jump remove $code failed; nothing else was removed"
        done
    fi
    run "$VPS_SSH" vps.sh undo
    run "$PI_SSH" pi.sh undo "${1:-}"
}

case "${1:-}" in
    config) cmd_config ;;
    ssh-config) cmd_ssh_config ;;
    base) cmd_base ;;
    link) cmd_link ;;
    exit) cmd_exit ;;
    client) shift; cmd_client "$@" ;;
    lan-mode) shift; cmd_lan_mode "$@" ;;
    check) cmd_check ;;
    all) cmd_link; cmd_exit; cmd_check ;;
    undo) shift; cmd_undo "$@" ;;
    *) sed -n '2,19s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
